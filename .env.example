# Telegram Bot API token, from @BotFather. Pending — Meera to provide.
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN

# Gemini API key, from https://aistudio.google.com/. Pending — Meera to provide.
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY

# The chat/channel id the bot delivers drafts back to. Pending — set once the bot is added to the channel.
TELEGRAM_CHAT_ID=REPLACE_ME_TELEGRAM_CHAT_ID

# "mock" runs ingestion/delivery against tests/sample_messages.json and prints
# instead of calling Telegram/Gemini. Switch to "live" once real credentials above
# are filled in.
PIPELINE_MODE=mock
