# Telegram Bot API token, from @BotFather. Pending — Meera to provide.
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN

# Gemini API key, from https://aistudio.google.com/. Pending — Meera to provide.
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY

# The chat/channel id the bot delivers drafts back to. Pending — set once the bot is added to the channel.
TELEGRAM_CHAT_ID=REPLACE_ME_TELEGRAM_CHAT_ID

# "mock" runs ingest/deliver against tests/sample_messages.json and prints
# instead of calling Telegram. "live" polls/sends via the real Telegram API.
# Screening/drafting always call the real Gemini API regardless of this.
PIPELINE_MODE=mock

# "local" (default) reads/writes data/tracker.json and data/notes/ on local
# disk — used for local dev with main.py. "github" reads/writes the same
# paths in the GitHub repo via its API instead — required for the deployed
# Vercel webhook, which has no persistent local filesystem. Local dev never
# needs to set this.
STORAGE_BACKEND=local

# Only needed when STORAGE_BACKEND=github (i.e. on Vercel). A fine-grained
# GitHub token scoped to this one repo with Contents: Read and write.
GITHUB_TOKEN=REPLACE_ME_GITHUB_TOKEN

# Only needed when STORAGE_BACKEND=github. Format: "owner/repo".
GITHUB_REPO=REPLACE_ME_GITHUB_REPO
